DJANGO_SECRET_KEY=replace-with-your-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost 127.0.0.1
DEMO_MODE=False
# Set this only while a Cloudflare Quick Tunnel is running.
PUBLIC_BASE_URL=
# Render supplies DATABASE_URL automatically when PostgreSQL is linked.
DATABASE_URL=
# Render sets RENDER=true automatically.
RENDER=False
RENDER_EXTERNAL_HOSTNAME=
# Optional custom production hosts/origins (space or comma separated).
DJANGO_CSRF_TRUSTED_ORIGINS=
POSTGRES_DB=playbite
POSTGRES_USER=playbite_user
POSTGRES_PASSWORD=secure_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
